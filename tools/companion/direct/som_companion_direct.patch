   return 0;
 }
+
+/* ------------------------------------------------------------------ direct mode glue */
+int som_cmd_direct(struct somd *d, const uint8_t *wram, const struct som_cmd *cmd, struct somd_target target) {
+  switch (cmd->kind) {
+  case SOM_CMD_EQUIP_WEAPON: return somd_equip(d, wram, cmd->hero, cmd->arg);
+  case SOM_CMD_USE_ITEM: return somd_use_item(d, wram, cmd->arg, target);
+  case SOM_CMD_CAST_MAGIC: {
+    /* E3C8 index 7 is the girl's Lumina, the sprite's Shade is index 6: both are spirit position 6 for somd_cast() */
+    int pos = (cmd->hero == 1 && cmd->arg == 7) ? 6 : cmd->arg;
+    return somd_cast(d, wram, cmd->hero, pos, cmd->spell, target);
+  }
+  default: return SOMD_ERR_BAD_ARGUMENT;
+  }
+}
