+/* ---- SoM companion widescreen (see tools/companion/widescreen, docs/companion-widescreen-core-20261017.md) ----
+ * When libretro.cpp sets som_ws_mode = 2, each batch of scanlines is rendered three times by the stock
+ * renderer: the screen 256 px to the left (BG H offset - 256, sprites +256), the screen 256 px to the
+ * right, and the normal screen, last, so GFX.Screen stays exactly the stock frame.  The three 256 px slices
+ * are stored side by side in som_ws_buf (768 px per line).  som_ws_mode = 1 only validates the map (no
+ * side render), 0 is the stock path.  Debug env: SOM_WS_BG3=1 keeps BG3 in the side passes, SOM_WS_OBJ=0
+ * drops sprites in them, SOM_WS_FIX=0 keeps the game's tilemap, SOM_WS_RAW=1 shows unvalidated layers.
+ */
+uint16 som_ws_buf[240 * 768];
+static int som_dbg = -1;
+int som_m7_dx = 0;
+int som_ws_mode = 0, som_ws_init_done = 0, som_ws_bg3 = 0, som_ws_obj = 1, som_ws_ok = 0, som_ws_fix = 1, som_ws_mask = 0, som_ws_raw = 0;
+/* Per-frame map validation, read and reset by libretro.cpp at the end of each frame. */
+int som_ws_fr_batches = 0, som_ws_fr_strict = 1, som_ws_fr_show = 1, som_ws_fr_mode7 = 0, som_ws_fr_layout = 0;
+static int som_ws_batch_show = 0, som_ws_batch_partial = 0;
+uint8 som_ws_skyfix[240];
+static int som_ws_m7_cur = 0, som_ws_m7_prev = 0;   /* a Mode 7 batch was seen in this / the previous frame (flights switch Mode 1 sky -> Mode 7 floor mid-frame) */
+#define SOM_WS_M7MIX (PPU.BGMode != 7 && som_ws_m7_prev)
+int som_ws_stat[4];   /* test hooks, cumulative: batches without a side render because the mode is not supported, batches with no valid layer, side passes drawn */
+void som_ws_frame_reset (void) { som_ws_fr_batches = 0; som_ws_fr_strict = 1; som_ws_fr_show = 1; som_ws_fr_mode7 = 0; som_ws_fr_layout = 0; }
+static void som_ws_init (void)
+{
+	som_ws_init_done = 1;
+	const char *e = getenv("SOM_WS_BG3"); som_ws_bg3 = e && *e == '1';
+	e = getenv("SOM_WS_OBJ"); som_ws_obj = !(e && *e == '0');
+	e = getenv("SOM_WS_FIX"); som_ws_fix = !(e && *e == '0');
+	e = getenv("SOM_WS_RAW"); som_ws_raw = e && *e == '1';
+	e = getenv("SOM_WS_MASK"); som_ws_mask = e && *e == '1';
+}
+static void SetupOBJ (void);
+static inline void RenderScreen (bool8 sub);
+extern int som_ws_fix, som_ws_mask;
+static void som_ws_copy (int slice)
+{
+	int camx = (int16) (Memory.RAM[0xA8] | (Memory.RAM[0xA9] << 8)), mapw = Memory.RAM[0xC0] | (Memory.RAM[0xC1] << 8);
+	for (uint32 y = GFX.StartY; y <= GFX.EndY && y < 240; y++)
+	{
+		uint16 *d = som_ws_buf + y * 768 + slice * 256;
+		memcpy(d, GFX.Screen + y * GFX.PPL, 256 * sizeof(uint16));
+		if (som_ws_mask && slice != 1 && mapw)
+			for (int x = 0; x < 256; x++)
+			{
+				int wx = camx + x + (slice - 1) * 256;
+				if (wx < 0 || wx >= mapw)
+					d[x] = 0;
+			}
+	}
+}
+/* SoM keeps the whole map in WRAM: tile ids $7F:0000 (layer 1) and $7F:4000 (layer 2), 128 cells per row,
+ * tilemap words $7F:C000 / $7F:C800 + 8 * id, camera $A8/$AA and $AC/$AE, map size $C0/$C2.  The game streams
+ * only about one 8 px column beyond the view into the 64 x 32 tilemaps, so for the side passes the whole
+ * 512 px tilemap is rewritten from WRAM, centred on the camera, and restored afterwards. */
+uint32 som_ws_cmp[2][2];
+static uint8 som_vram_saved[2][0x1000];
+static int som_vram_fixed[2];
+extern int som_ws_raw;
+static inline int som_ramw (int a) { return Memory.RAM[a] | (Memory.RAM[a + 1] << 8); }
+int som_ws_layer_ok[2], som_ws_layer_draw[2];
+static int som_ws_k_age[2] = { 100000, 100000 };   /* evaluations since the layer last matched strictly */
+static void som_ws_tilemaps (bool apply)
+{
+	for (int L = 0; L < 2; L++)
+	{
+		som_vram_fixed[L] = 0;
+		som_ws_layer_ok[L] = 0;
+		som_ws_layer_draw[L] = 0;
+		if (PPU.BG[L].SCSize != 1 || PPU.BG[L].SCBase > 0x7c00)
+			continue;
+		uint8 *base = Memory.VRAM + PPU.BG[L].SCBase * 2;
+		static uint16 nw[2048];
+		int camx = (int16) som_ramw(L ? 0xAC : 0xA8), camy = (int16) som_ramw(L ? 0xAE : 0xAA);
+		const uint8 *ids = Memory.RAM + 0x10000 + L * 0x4000;
+		const uint8 *wd = Memory.RAM + 0x1C000 + L * 0x800;
+		/* The game's own tilemap offset: BG scroll minus camera, in 8 px cells.  It is constant for a map load, but the scroll
+		 * registers and the WRAM camera are written at different times, so on a frame where they disagree (a fast camera
+		 * move, the ring opening, a screen shake) the value derived from them is off by cells.  The derived value is tried
+		 * first; if it does not match the game's tilemap, the last value that did match and then its neighbours are tried. */
+		int colK = ((((int) LineData[GFX.StartY].BG[L].HOffset - camx) + 4) >> 3) & 63;
+		int rowK = ((((int) LineData[GFX.StartY].BG[L].VOffset - 1 - camy) + 4) >> 3) & 31;
+		int vc = ((LineData[GFX.StartY].BG[L].HOffset >> 3) & 63), vr = ((LineData[GFX.StartY].BG[L].VOffset >> 3) & 31);
+		uint32 cmp = 0, bad = 0;
+		int mapw = som_ramw(L ? 0xC4 : 0xC0), maph = som_ramw(L ? 0xC6 : 0xC2);
+		uint16 blank = 0;
+		{
+			/* a character that is all zero stands in for "no map here" (shows the backdrop) */
+			const uint8 *ch = Memory.VRAM + ((PPU.BG[L].NameBase * 2) & 0xffff);
+			for (int i = 0; i < 1024 && ((i + 1) * 32 + (PPU.BG[L].NameBase * 2)) <= 0x10000; i++)
+			{
+				int z = 1;
+				for (int k = 0; k < 32; k++) if (ch[i * 32 + k]) { z = 0; break; }
+				if (z) { blank = i; break; }
+			}
+		}
+		/* Tilemap cell (r, c) shows world cell (bx, by): the 33 x 29 cells in view run from (bxl, byt) on and the rest of the
+		 * 64 x 32 map continues them (16 columns before, 15 after the view, 3 rows below it), whatever the camera says. */
+		/* Left and right of the map the game has nothing to show (the stock view never gets there): the side passes mirror the map at its
+		 * edge instead (tiles flipped), so a scene that fills the view keeps going instead of ending in a band of backdrop colour. */
+		int mapcw = mapw < 2048 ? (mapw + 7) >> 3 : 256, mapch = maph < 2048 ? (maph + 7) >> 3 : 256;
+		/* Some scenes loop the map (the Mana Fortress of the opening scrolls past forever): the game wraps the camera and streams the
+		 * map's other end in beyond the edge.  wrap bit 0 / 1 = the layer wraps horizontally / vertically, found by scoring below. */
+		int wrap = 0;
+		auto cell = [&](int ck, int rk, int r, int c, bool mirror = false) -> int {   /* -1 = outside the map */
+			int bxl = (((vc - ck) - (camx >> 3) + 32) & 63) + (camx >> 3) - 32;
+			int byt = (((vr - rk) - (camy >> 3) + 16) & 31) + (camy >> 3) - 16;
+			int by = byt + ((r - vr) & 31), bx = bxl + ((c - vc + 16) & 63) - 16, flip = 0;
+			if ((wrap & 1) && mapcw > 0 && !(mapcw & 1)) bx = ((bx % mapcw) + mapcw) % mapcw;
+			if ((wrap & 2) && mapch > 0 && !(mapch & 1)) by = ((by % mapch) + mapch) % mapch;
+			if (mirror && mapcw > 0 && (bx < 0 || bx >= mapcw) && bx >= -mapcw && bx < 2 * mapcw)
+			{
+				bx = bx < 0 ? -1 - bx : 2 * mapcw - 1 - bx;
+				flip = 0x4000;
+			}
+			int cx = bx >> 1, cy = by >> 1;
+			if (cx >= 0 && cx < 128 && cy >= 0 && cy < 128 && cx * 16 < mapw && cy * 16 < maph)
+			{
+				int id = ids[cy * 128 + cx];
+				const uint8 *q = wd + 8 * id + (((by & 1) * 2 + (bx & 1)) * 2);
+				return (q[0] | (q[1] << 8)) ^ flip;
+			}
+			return -1;
+		};
+		auto score = [&](int ck, int rk, uint32 &n) -> uint32 {
+			uint32 b = 0; n = 0;
+			for (int r = 0; r < 32; r++)
+			{
+				if (((r - vr) & 31) >= 24) continue;
+				for (int c = 0; c < 64; c++)
+				{
+					if (((c - vc) & 63) >= 33) continue;
+					int o = (c >= 32 ? 0x400 : 0) + r * 32 + (c & 31);
+					int w = cell(ck, rk, r, c);
+					if (w < 0) continue;   /* beyond the map edge the game may show anything (wall tiles, padding): not compared */
+					n++;
+					if ((base[o * 2] | (base[o * 2 + 1] << 8)) != w) b++;
+				}
+			}
+			return b;
+		};
+		static int k_last[2][2] = { { -1, -1 }, { -1, -1 } };
+		int ck = colK, rk = rowK;
+		bad = score(ck, rk, cmp);
+		/* A wrapped axis is taken when it brings at least 4 more lines of the view into the comparison and they match the game's
+		 * tilemap; it then stays while the map is the same and still matches (a single column past the edge proves nothing). */
+		static int wrap_last[2], wrap_map[2];
+		int mapkey = mapw * 4096 + maph + (Memory.RAM[0xDC] << 24);
+		if (wrap_map[L] != mapkey) { wrap_map[L] = mapkey; wrap_last[L] = 0; }
+		for (int w = 1; w <= 2; w++)
+		{
+			uint32 n, b;
+			wrap |= w;
+			b = score(ck, rk, n);
+			if (b * 50 <= n && (n >= cmp + 96 || ((wrap_last[L] & w) && n >= cmp))) { bad = b; cmp = n; }
+			else wrap &= ~w;
+		}
+		wrap_last[L] = wrap;
+		if (cmp && bad * 50 <= cmp)
+		{
+			k_last[L][0] = ck; k_last[L][1] = rk;
+		}
+		else if (cmp)
+		{
+			som_ws_stat[3]++;
+			uint32 best = bad, n;
+			int bc = ck, br = rk;
+			if (k_last[L][0] >= 0)
+			{
+				uint32 b = score(k_last[L][0], k_last[L][1], n);
+				if (b < best) { best = b; bc = k_last[L][0]; br = k_last[L][1]; }
+			}
+			for (int pass = 0; pass < 2 && best * 50 > cmp; pass++)
+			{
+				int c0 = pass ? k_last[L][0] : colK, r0 = pass ? k_last[L][1] : rowK;
+				if (c0 < 0) continue;
+				for (int dr = -2; dr <= 2; dr++)
+					for (int dc = -2; dc <= 2; dc++)
+					{
+						uint32 b = score((c0 + dc) & 63, (r0 + dr) & 31, n);
+						if (b < best) { best = b; bc = (c0 + dc) & 63; br = (r0 + dr) & 31; }
+					}
+			}
+			bad = best; ck = bc; rk = br;
+			if (cmp && bad * 50 <= cmp) { k_last[L][0] = ck; k_last[L][1] = rk; }
+		}
+		colK = ck; rowK = rk;
+		/* A layer that matched the game's tilemap a moment ago keeps being drawn while a few more cells differ (up to 10 %, e.g. a
+		 * tile the game changes in VRAM only, or a map that is being streamed); the strict 2 % result still drives the
+		 * widen / fall back decision. */
+		int strict_ok = cmp && bad * 50 <= cmp;
+		som_ws_k_age[L] = strict_ok ? 0 : som_ws_k_age[L] + 1;
+		int draw_ok = strict_ok || (cmp && som_ws_k_age[L] <= 600 && bad * 10 <= cmp);
+		if (draw_ok)
+			for (int r = 0; r < 32; r++)
+				for (int c = 0; c < 64; c++)
+				{
+					int o = (c >= 32 ? 0x400 : 0) + r * 32 + (c & 31), w = cell(ck, rk, r, c, true);
+					/* outside the map: the picture in view keeps the game's own cell (the centre shows it too), the rest is blank */
+					if (w < 0) w = (((c - vc) & 63) < 33 && ((r - vr) & 31) < 29) ? (base[o * 2] | (base[o * 2 + 1] << 8)) : blank;
+					nw[o] = w;
+				}
+		if (GFX.StartY < 100) { som_ws_cmp[L][0] += cmp; som_ws_cmp[L][1] += bad; }
+		som_ws_layer_ok[L] = strict_ok;
+		som_ws_layer_draw[L] = draw_ok;
+		if (!draw_ok || !apply)
+			continue;
+		memcpy(som_vram_saved[L], base, 0x1000);
+		for (int o = 0; o < 2048; o++) { base[o * 2] = nw[o] & 0xff; base[o * 2 + 1] = nw[o] >> 8; }
+		som_vram_fixed[L] = 1;
+	}
+}
+/* A batch is "strict" when every enabled BG1/BG2 layer was rebuilt and matches the game's own tilemap, and
+ * "show" when at least one enabled layer did (the side passes draw the valid layers only). */
+static void som_ws_batch_flags (void)
+{
+	if (PPU.BGMode == 7 || SOM_WS_M7MIX)
+	{
+		if (PPU.BGMode == 7) som_ws_m7_cur = 1;
+		/* Mode 7 (and the Mode 1 sky above it in the same frame, which is not the field layout): the side passes evaluate the same per-line affine map at screen columns outside 0..255; there is no tilemap to check */
+		som_ws_layer_ok[0] = som_ws_layer_ok[1] = som_ws_layer_draw[0] = som_ws_layer_draw[1] = 1;
+		som_ws_batch_show = 1; som_ws_batch_partial = 0; som_ws_fr_batches++;
+		return;
+	}
+	int en = Memory.FillRAM[0x212c] | Memory.FillRAM[0x212d], strict = 1, show = 0, any = 0, partial = 0;
+	if (!som_ws_fix)
+		som_ws_layer_ok[0] = som_ws_layer_ok[1] = som_ws_layer_draw[0] = som_ws_layer_draw[1] = 1;
+	for (int L = 0; L < 2; L++)
+		if (en & (1 << L))
+		{
+			any = 1;
+			if (PPU.BG[L].SCSize != 1) som_ws_fr_layout = 1;
+			if (som_ws_layer_draw[L]) show = 1;
+			else if (som_ws_k_age[L] <= 60) partial = 1;   /* a layer that matched a moment ago is missing now */
+			if (!som_ws_layer_ok[L]) strict = 0;
+		}
+	if (!any) strict = 0;
+	if (som_ws_raw) show = 1;
+	som_ws_batch_show = show;
+	som_ws_batch_partial = partial && !som_ws_raw;
+	som_ws_fr_batches++;
+	som_ws_fr_strict &= strict;
+	som_ws_fr_show &= show;
+}
+static void som_ws_validate (void)
+{
+	if (PPU.BGMode != 7 && !SOM_WS_M7MIX) som_ws_tilemaps(false);
+	som_ws_batch_flags();
+}
+static void som_ws_notok (void)
+{
+	som_ws_stat[0]++;
+	som_ws_fr_batches++;
+	som_ws_fr_strict = 0;
+	som_ws_fr_show = 0;
+	if (PPU.BGMode == 7) som_ws_fr_mode7 = 1; else som_ws_fr_layout = 1;
+}
+static void som_ws_black (int slice)
+{
+	for (uint32 y = GFX.StartY; y <= GFX.EndY && y < 240; y++)
+		memset(som_ws_buf + y * 768 + slice * 256, 0, 256 * sizeof(uint16));
+}
+static void som_ws_tilemaps_restore (void)
+{
+	for (int L = 0; L < 2; L++)
+		if (som_vram_fixed[L])
+			memcpy(Memory.VRAM + PPU.BG[L].SCBase * 2, som_vram_saved[L], 0x1000);
+}
+static unsigned som_ws_fid;   /* counts frames rendered while the side passes are on */
+/* True while the side columns may keep what was drawn last instead of going black: the first 6 consecutive frames in which a
+ * batch cannot be drawn.  A momentary miss (a tilemap the game is rewriting, a hi-res or interlace bit set for a few lines)
+ * would otherwise flash black bands in the sides. */
+static int som_ws_hold (void)
+{
+	static unsigned last_fid = 0xffffffffu;
+	static int consec = 0;
+	if (last_fid != som_ws_fid) { consec = (last_fid + 1 == som_ws_fid) ? consec + 1 : 1; last_fid = som_ws_fid; }
+	return consec <= 6;
+}
+/* Mode 1 sky above a Mode 7 floor (Flammie): the cloud layers are 512 px tilemaps that the game streams as the heading turns, so the
+ * columns beyond the view hold whatever was streamed there last.  The game streams them from two ROM tables of whole-turn panoramas: one
+ * column of 16 tile bytes (the low byte of rows 0..15; the high bytes are set once per row) per 8 px, 224 columns for BG1 at C6:5700 and
+ * 160 for BG2 at C6:4A00 (a full turn moves BG1 by 1792 px and BG2 by 1280 px: parallax), by DMA from $00:88B7 / $00:88CE in the free
+ * flights and the opening flight alike.  The side columns are drawn from those tables: rows 0..15 take the table's byte for their place on
+ * the panorama, exactly what the game would stream there, and the rows below keep the game's own cells (they are never streamed).  The
+ * place of the view's first column is found by matching the view with the table, then followed with the layer's scroll and checked
+ * against the view every frame.  When a table does not match (another ROM), the sides fall back to the cells seen in the view at their
+ * place on the panorama, and to the row's most common cell (empty sky in a cloud row) where none was seen. */
+#define SOM_SKY_COLS 1024
+static uint16 som_sky_pan[2][32][SOM_SKY_COLS];
+static uint8 som_sky_have[2][32][SOM_SKY_COLS];
+static unsigned som_sky_last_fid = 0;
+static const int som_sky_s[2] = { 7, 5 };
+static const uint32 som_sky_tab[2] = { 0xc65700, 0xc64a00 };
+static int som_sky_x[2], som_sky_pH[2], som_sky_ok = 0;   /* panorama x of the screen's left edge, last scroll */
+static int som_sky_s0[2] = { -1, -1 }, som_sky_s0kc[2];   /* table column of the view's column 0 (-1: no match), at panorama column */
+static unsigned som_sky_s0fid[2];
+static struct { uint8 L, r, c; uint16 w; } som_ws_sky_saved[2 * 32 * 18];
+static int som_ws_sky_n = 0;
+static void som_ws_sky_track (void)
+{
+	if (som_ws_fid - som_sky_last_fid > 30)
+	{
+		memset(som_sky_have, 0, sizeof som_sky_have);   /* a new flight */
+		som_sky_ok = 0;
+		som_sky_s0[0] = som_sky_s0[1] = -1;
+	}
+	som_sky_last_fid = som_ws_fid;
+	for (int L = 0; L < 2; L++)
+	{
+		int H = LineData[GFX.StartY].BG[L].HOffset, P = 256 * som_sky_s[L];
+		int dH = (int16) (H - som_sky_pH[L]);
+		if (som_sky_ok && abs(dH) <= 32 * som_sky_s[L])
+			som_sky_x[L] = (((som_sky_x[L] + dH) % P) + P) % P;
+		else
+		{
+			memset(som_sky_have[L], 0, sizeof som_sky_have[L]);
+			som_sky_x[L] = ((H % P) + P) % P;
+			som_sky_s0[L] = -1;
+		}
+		som_sky_pH[L] = H;
+	}
+	som_sky_ok = 1;
+}
+static const uint8 *som_sky_table (int L)   /* the ROM table of layer L, or NULL */
+{
+	uint32 a = som_sky_tab[L];
+	uint8 *p = Memory.Map[(a & 0xffffff) >> MEMMAP_SHIFT];
+	if (p < (uint8 *) CMemory::MAP_LAST || (a & 0xffff) + 16 * 32 * som_sky_s[L] > 0x10000) return NULL;
+	return p + (a & 0xffff);
+}
+/* 1 when table column s0 + i holds the low bytes of tilemap column hc + i for the view's inner columns (the outer two may be streamed late) */
+static int som_sky_match (const uint8 *tab, int n, const uint8 *base, int hc, int last, int s0)
+{
+	for (int i = 2; i < last; i++)
+	{
+		int tc = (hc + i) & 63, col = (s0 + i) % n;
+		for (int r = 0; r < 16; r++)
+			if (base[((tc >= 32 ? 0x400 : 0) + r * 32 + (tc & 31)) * 2] != tab[16 * col + r]) return 0;
+	}
+	return 1;
+}
+static int som_ws_sky_fill (void)   /* 0: a sky layer in view is not a 512 x 256 tilemap (nothing rewritten) */
+{
+	som_ws_sky_n = 0;
+	if (GFX.StartY == 0 || som_ws_fid != som_sky_last_fid) som_ws_sky_track();
+	int tm = Memory.FillRAM[0x212c] | Memory.FillRAM[0x212d];
+	for (int L = 0; L < 2; L++)
+		if ((tm & (1 << L)) && (PPU.BG[L].SCSize != 1 || PPU.BG[L].SCBase > 0x7c00))
+			return 0;
+	for (int L = 0; L < 2; L++)
+	{
+		if (PPU.BG[L].SCSize != 1 || PPU.BG[L].SCBase > 0x7c00)
+			continue;
+		uint8 *base = Memory.VRAM + PPU.BG[L].SCBase * 2;
+		int H = LineData[GFX.StartY].BG[L].HOffset, hc = (H & 1023) >> 3, v = LineData[GFX.StartY].BG[L].VOffset;
+		int last = (H & 7) ? 32 : 31;   /* the last column the view shows */
+		int pc = 32 * som_sky_s[L], kc = som_sky_x[L] >> 3;   /* panorama columns, panorama column of view column 0 */
+		const uint8 *tab = som_sky_table(L);
+		if (tab && som_sky_s0fid[L] != som_ws_fid)   /* once a frame: where the view sits in the table */
+		{
+			som_sky_s0fid[L] = som_ws_fid;
+			int pred = som_sky_s0[L] < 0 ? -1 : ((som_sky_s0[L] + kc - som_sky_s0kc[L]) % pc + pc) % pc, s0 = -1;
+			if (pred >= 0 && som_sky_match(tab, pc, base, hc, last, pred)) s0 = pred;
+			else
+				for (int k = 0, bestd = pc; k < pc; k++)
+					if (som_sky_match(tab, pc, base, hc, last, k))
+					{
+						int d = pred < 0 ? 0 : abs(k - pred) < pc - abs(k - pred) ? abs(k - pred) : pc - abs(k - pred);
+						if (d < bestd) bestd = d, s0 = k;
+					}
+			som_sky_s0[L] = s0; som_sky_s0kc[L] = kc;
+		}
+		int s0 = tab ? som_sky_s0[L] : -1;
+		uint8 rows[32] = { 0 };
+		for (uint32 y = GFX.StartY; y <= GFX.EndY && y < 240; y++) rows[((v + y) >> 3) & 31] = 1;
+		for (int r = 0; r < 32; r++)
+		{
+			if (!rows[r]) continue;
+			uint16 seen[33]; int ns = 0;
+			for (int i = 1; i <= last; i++)
+			{
+				int tc = (hc + i) & 63, o = (tc >= 32 ? 0x400 : 0) + r * 32 + (tc & 31), k = (kc + i) % pc;
+				som_sky_pan[L][r][k] = seen[ns++] = base[o * 2] | (base[o * 2 + 1] << 8);
+				som_sky_have[L][r][k] = 1;
+			}
+			if (s0 >= 0 && r >= 16) continue;   /* rows the game never streams: its own cells are right */
+			int fill = 0, best = 0;
+			if (s0 < 0)
+				for (int i = 0; i < ns; i++)
+				{
+					int n = 0;
+					for (int j = 0; j < ns; j++) n += seen[j] == seen[i];
+					if (n > best) best = n, fill = seen[i];
+				}
+			for (int i = -8; i <= 41; i++)
+			{
+				if (i == 0) i = last + 1;
+				int tc = (hc + i) & 63, o = (tc >= 32 ? 0x400 : 0) + r * 32 + (tc & 31), k = ((kc + i) % pc + pc) % pc;
+				int raw = base[o * 2] | (base[o * 2 + 1] << 8), w;
+				if (s0 >= 0) w = (raw & 0xff00) | tab[16 * (((s0 + i) % pc + pc) % pc) + r];
+				else w = som_sky_have[L][r][k] ? som_sky_pan[L][r][k] : fill;
+				som_ws_sky_saved[som_ws_sky_n].L = L; som_ws_sky_saved[som_ws_sky_n].r = r; som_ws_sky_saved[som_ws_sky_n].c = tc;
+				som_ws_sky_saved[som_ws_sky_n++].w = raw;
+				base[o * 2] = w & 0xff; base[o * 2 + 1] = w >> 8;
+			}
+		}
+	}
+	return 1;
+}
+static void som_ws_sky_restore (void)
+{
+	for (int k = som_ws_sky_n - 1; k >= 0; k--)
+	{
+		uint8 *base = Memory.VRAM + PPU.BG[som_ws_sky_saved[k].L].SCBase * 2;
+		int tc = som_ws_sky_saved[k].c, o = (tc >= 32 ? 0x400 : 0) + som_ws_sky_saved[k].r * 32 + (tc & 31);
+		base[o * 2] = som_ws_sky_saved[k].w & 0xff; base[o * 2 + 1] = som_ws_sky_saved[k].w >> 8;
+	}
+	som_ws_sky_n = 0;
+}
+static void som_ws_passes (void)
+{
+	if (som_dbg < 0) { const char *e = getenv("SOM_WS_DBG"); som_dbg = e ? atoi(e) : 0; }
+	if (som_dbg & 32) return;
+	static struct SLineData saved[240];
+	static int16 hpos[128];
+	uint8 forced = Settings.BG_Forced;
+	for (uint32 y = GFX.StartY; y <= GFX.EndY && y < 240; y++) saved[y] = LineData[y];
+	for (int i = 0; i < 128; i++) hpos[i] = PPU.OBJ[i].HPos;
+	som_ws_sky_n = 0;
+	if (SOM_WS_M7MIX && !som_ws_sky_fill())
+	{
+		/* Sky that cannot be rebuilt (a sky layer of another tilemap size; not seen in the game's flights): the layers hold black or stale
+		 * cells beyond the view, so the sides mirror the centre (libretro.cpp) instead, from a copy drawn without sprites (the compass
+		 * letters and Flammie are not mirrored).  The copy goes to the left slice, which these rows do not use otherwise. */
+		for (uint32 y = GFX.StartY; y <= GFX.EndY && y < 240; y++) som_ws_skyfix[y] = 1;
+		som_ws_batch_flags();
+		som_ws_stat[2]++;
+		Settings.BG_Forced = forced | 16;
+		if (PPU.BGMode == 5 || PPU.BGMode == 6 || IPPU.PseudoHires ||
+			((Memory.FillRAM[0x2130] & 0x30) != 0x30 && (Memory.FillRAM[0x2130] & 2) && (Memory.FillRAM[0x2131] & 0x3f) && (Memory.FillRAM[0x212d] & 0x1f)))
+			RenderScreen(TRUE);
+		RenderScreen(FALSE);
+		som_ws_copy(0);
+		memset(GFX.ZBuffer + GFX.StartY * GFX.PPL, 0, (GFX.EndY - GFX.StartY + 1) * GFX.PPL);
+		memset(GFX.SubZBuffer + GFX.StartY * GFX.PPL, 0, (GFX.EndY - GFX.StartY + 1) * GFX.PPL);
+		Settings.BG_Forced = forced;
+		som_vram_fixed[0] = som_vram_fixed[1] = 0;
+		return;
+	}
+	if (som_ws_fix && PPU.BGMode != 7 && !SOM_WS_M7MIX) som_ws_tilemaps(true); else som_vram_fixed[0] = som_vram_fixed[1] = 0;
+	som_ws_batch_flags();
+	if (!som_ws_batch_show || som_ws_batch_partial)
+	{
+		/* Nothing valid to draw, or a layer that was fine a moment ago is missing (drawing the rest would make it blink): no extra
+		 * render, the sides hold the last picture for a few frames; after that they go black (nothing valid) or show what is valid. */
+		int hold = som_ws_hold();
+		if (hold || !som_ws_batch_show)
+		{
+			som_ws_stat[1]++;
+			som_ws_tilemaps_restore();
+			som_ws_sky_restore();
+			if (!hold)
+			{
+				som_ws_black(0);
+				som_ws_black(2);
+			}
+			return;
+		}
+	}
+	if (som_dbg == 78 && GFX.StartY == 0)
+	{
+		for (int L = 0; L < 3; L++)
+		{
+			int nz[2] = { 0, 0 }; uint8 *b = Memory.VRAM + PPU.BG[L].SCBase * 2;
+			for (int i = 0; i < 2048; i++) if (b[i * 2] | b[i * 2 + 1]) nz[i >= 1024]++;
+			fprintf(stderr, "BG%d size=%d base=%04x h=%d v=%d nz=%d/%d tm=%02x\n", L, PPU.BG[L].SCSize, PPU.BG[L].SCBase, LineData[0].BG[L].HOffset, LineData[0].BG[L].VOffset, nz[0], nz[1], Memory.FillRAM[0x212c]);
+		}
+	}
+	som_ws_stat[2]++;
+	/* Windows are screen coordinates (the sword effect is a window ellipse), so the side renders get their own window state (below) and the
+	 * original one is restored afterwards. */
+	uint8 wsave[4] = { PPU.Window1Left, PPU.Window1Right, PPU.Window2Left, PPU.Window2Right };
+	bool8 wuse = !(som_dbg & 64);
+	for (int dir = -1; dir <= 1; dir += 2)
+	{
+		int bg3_side = som_ws_bg3;
+		if (wuse)
+		{
+			/* a window that touches the screen edge on this side keeps going over the whole side column; one that closes before the edge does not
+			 * reach it (an ellipse that fills the screen carries on, a small one is not repeated) */
+			bool w1 = wsave[0] <= wsave[1] && (dir < 0 ? wsave[0] == 0 : wsave[1] == 255), w2 = wsave[2] <= wsave[3] && (dir < 0 ? wsave[2] == 0 : wsave[3] == 255);
+			PPU.Window1Left = w1 ? 0 : 1; PPU.Window1Right = w1 ? 255 : 0;
+			PPU.Window2Left = w2 ? 0 : 1; PPU.Window2Right = w2 ? 255 : 0;
+			S9xComputeClipWindows();
+			/* A band where the window hides every main-screen BG1/BG2 cell on this side (the log bridge of the opening: BG1/BG2 are masked
+			 * over the full width and the log is a BG3 strip) shows only BG3 there, so BG3 is drawn in this side pass too: its 256 px
+			 * tilemap wraps, so the strip carries on instead of leaving a black band. */
+			int tm = Memory.FillRAM[0x212c], tmw = Memory.FillRAM[0x212e], any = 0, hidden = 1;
+			for (int L = 0; L < 2; L++)
+			{
+				if (!(tm & (1 << L))) continue;
+				int sel = Memory.FillRAM[0x2123] >> (L * 4);
+				bool in1 = (sel & 2) && (w1 != !!(sel & 1)), in2 = (sel & 8) && (w2 != !!(sel & 4));
+				int logic = (Memory.FillRAM[0x212a] >> (L * 2)) & 3;
+				bool masked = (tmw & (1 << L)) && ((sel & 2) && (sel & 8) ? (logic == 0 ? in1 || in2 : logic == 1 ? in1 && in2 : logic == 2 ? in1 != in2 : in1 == in2) : (in1 || in2));
+				any = 1;
+				if (!masked) hidden = 0;
+			}
+			if (any && hidden && (tm & 4)) bg3_side = 1;
+		}
+		for (uint32 y = GFX.StartY; y <= GFX.EndY && y < 240; y++)
+			for (int b = 0; b < 3; b++)
+				LineData[y].BG[b].HOffset = (uint16) (saved[y].BG[b].HOffset + dir * 256) & 0x3ff;
+		for (int i = 0; i < 128; i++)
+		{
+			int h = hpos[i] - dir * 256;
+			PPU.OBJ[i].HPos = (int16) (((h + 256) & 511) - 256);
+		}
+		som_m7_dx = dir * 256;
+		Settings.BG_Forced = forced | (bg3_side ? 0 : 4) | (som_ws_obj ? 0 : 16);
+		if (som_ws_fix && !som_ws_raw)
+			Settings.BG_Forced |= (som_ws_layer_draw[0] ? 0 : 1) | (som_ws_layer_draw[1] ? 0 : 2);
+		if (!(som_dbg & 2)) SetupOBJ();
+		if (!(som_dbg & 1)) {
+		if (PPU.BGMode == 5 || PPU.BGMode == 6 || IPPU.PseudoHires ||
+			((Memory.FillRAM[0x2130] & 0x30) != 0x30 && (Memory.FillRAM[0x2130] & 2) && (Memory.FillRAM[0x2131] & 0x3f) && (Memory.FillRAM[0x212d] & 0x1f)))
+			RenderScreen(TRUE);
+		RenderScreen(FALSE); }
+		som_ws_copy(dir < 0 ? 0 : 2);
+		memset(GFX.ZBuffer + GFX.StartY * GFX.PPL, 0, (GFX.EndY - GFX.StartY + 1) * GFX.PPL);
+		memset(GFX.SubZBuffer + GFX.StartY * GFX.PPL, 0, (GFX.EndY - GFX.StartY + 1) * GFX.PPL);
+	}
+	som_m7_dx = 0;
+	if (wuse)
+	{
+		PPU.Window1Left = wsave[0]; PPU.Window1Right = wsave[1]; PPU.Window2Left = wsave[2]; PPU.Window2Right = wsave[3];
+		S9xComputeClipWindows();
+	}
+	if (som_ws_fix) som_ws_tilemaps_restore();
+	som_ws_sky_restore();
+	Settings.BG_Forced = forced;
+	for (uint32 y = GFX.StartY; y <= GFX.EndY && y < 240; y++) LineData[y] = saved[y];
+	for (int i = 0; i < 128; i++) PPU.OBJ[i].HPos = hpos[i];
+	if (!(som_dbg & 16)) SetupOBJ();
+}
+
+/* SoM HUD mask (option snes9x_som_hud = hide_except_ring).  The HUD is (a) three party portrait sprites in OAM
+ * slots 0..2 (16x16, y 199, x 8/88/168, tiles $E8/$EA/$EC, attr priority 3) and (b) three BG3 panels of 10 x 3
+ * cells at rows 25..27, columns 1+10p..10+10p (frame, name, HP/MP numbers, gauge); Ancient Cave adds a "FLOOR / time"
+ * line at row 23.  Unless the ring is open ($7D = 1, which also covers the status, equipment and config screens) the HUD
+ * is removed at render time in every other state: field, fades, transitions, events, dialogs.  A BG3 panel is
+ * recognised by its static frame cells (tile $016 at rows 25 and 26 of its first column, tile $013 at row 27 column 3),
+ * so screens that merely share BG3 rows (name entry and title are not Mode 1) are untouched, and a dialog box keeps
+ * its own cells (only the panel cells are cleared).  VRAM and OAM are restored after each scanline batch.  The decision
+ * is latched on the first batch of a frame (ring flag). */
+int som_hires_native = 0;
+int som_hud_opt = 0, som_hud_field = 0, som_hud_hidden_total = 0, som_hud_panels_total = 0, som_hud_panels_frame = 0;
+static int som_hud_n = 0, som_hud_idx[3];
+static uint16 som_hud_vpos[3];
+static uint8 som_hud3_saved[4][64];
+static int som_hud3_rows[4], som_hud3_n = 0;
+static inline int som_bg3_get (const uint8 *b, int r, int c) { const uint8 *q = b + (r * 32 + c) * 2; return q[0] | (q[1] << 8); }
+static void som_hud_bg3 (void)
+{
+	if (PPU.BGMode != 1 || PPU.BG[2].SCSize != 0 || PPU.BG[2].SCBase > 0x7c00)
+		return;
+	uint8 *b = Memory.VRAM + PPU.BG[2].SCBase * 2;
+	int present = 0;
+	for (int p = 0; p < 3; p++)
+	{
+		int c0 = 1 + 10 * p;
+		if ((som_bg3_get(b, 25, c0) & 0x3ff) == 0x016 && (som_bg3_get(b, 26, c0) & 0x3ff) == 0x016 &&
+			(som_bg3_get(b, 27, c0 + 2) & 0x3ff) == 0x013)
+			present |= 1 << p;
+	}
+	if (!present)
+		return;
+	som_hud_panels_frame |= present;
+	static const int rows[4] = { 23, 25, 26, 27 };
+	for (int k = 0; k < 4; k++)
+	{
+		som_hud3_rows[k] = rows[k];
+		memcpy(som_hud3_saved[k], b + rows[k] * 64, 64);
+		for (int c = 0; c < 32; c++)
+		{
+			int p = c >= 1 && c <= 30 ? (c - 1) / 10 : -1;
+			if (k == 0 ? (p >= 0) : (p >= 0 && (present & (1 << p))))
+				b[rows[k] * 64 + c * 2] = b[rows[k] * 64 + c * 2 + 1] = 0;
+		}
+	}
+	som_hud3_n = 4;
+}
+static void som_hud_begin (void)
+{
+	if (IPPU.PreviousLine == 0)
+	{
+		som_hud_field = Memory.RAM[0x7D] != 1;
+		som_hud_panels_total += som_hud_panels_frame ? 1 : 0;
+		som_hud_panels_frame = 0;
+	}
+	som_hud_n = 0;
+	som_hud3_n = 0;
+	if (!som_hud_field)
+		return;
+	som_hud_bg3();
+	for (int i = 0; i < 3; i++)
+	{
+		const uint8 *o = PPU.OAMData + i * 4;
+		int hi = (PPU.OAMData[512 + (i >> 2)] >> ((i & 3) * 2)) & 3;
+		if (o[1] == 199 && !(hi & 2) && (o[3] & 0x30) == 0x30 && o[2] >= 0xE8 && o[2] <= 0xEE && !(o[2] & 1) &&
+			(o[0] == 8 || o[0] == 88 || o[0] == 168) && !(hi & 1))
+		{
+			som_hud_idx[som_hud_n] = i;
+			som_hud_vpos[som_hud_n++] = PPU.OBJ[i].VPos;
+			PPU.OBJ[i].VPos = 240;
+		}
+	}
+	if (som_hud_n)
+	{
+		som_hud_hidden_total += som_hud_n;
+		SetupOBJ();
+	}
+}
+static void som_hud_end (void)
+{
+	for (int k = 0; k < som_hud_n; k++)
+		PPU.OBJ[som_hud_idx[k]].VPos = som_hud_vpos[k];
+	if (som_hud_n)
+		IPPU.OBJChanged = TRUE;
+	som_hud_n = 0;
+	if (som_hud3_n && PPU.BG[2].SCBase <= 0x7c00)
+	{
+		uint8 *b = Memory.VRAM + PPU.BG[2].SCBase * 2;
+		for (int k = 0; k < som_hud3_n; k++)
+			memcpy(b + som_hud3_rows[k] * 64, som_hud3_saved[k], 64);
+	}
+	som_hud3_n = 0;
+}
