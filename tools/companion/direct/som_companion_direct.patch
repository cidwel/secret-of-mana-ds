+/* ------------------------------------------------------------------ direct mode (no ring menu)
+ * som_direct runs the commit of a weapon / item / spell without opening the ring.  A frontend that supports it keeps a
+ * struct somd next to the macro, calls somd_pre_frame() before and somd_post_frame() after every retro_run(), and uses
+ * som_cmd_direct() as the drop-in twin of som_macro_start().  Design, limits and evidence: docs/companion-direct-20261017.md. */
+#include "direct/som_direct.h"
+
+/* Same command struct as the macro path.  cmd->hero is the caster (magic) or the equipping hero (weapon) or ignored (item);
+ * cmd->arg is the weapon type, the item record or the E3C8 spirit index; cmd->spell is the spell entry 0..2.  `target` is
+ * ignored for equip and for casts whose class is not targeted.  Returns SOMD_OK or the refusal (somd_err_name()). */
+int som_cmd_direct(struct somd *d, const uint8_t *wram, const struct som_cmd *cmd, struct somd_target target);
+
 #endif
